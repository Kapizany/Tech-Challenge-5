# Optional Kaggle authentication. Prefer ~/.kaggle/kaggle.json or KAGGLE_API_TOKEN.
KAGGLE_DATASET=henriqueyamahata/bank-marketing
DATA_PATH=data/raw/bank-additional-full.csv

# API local runtime persistence. Use ADAPTIVE_STORE=firestore in GCP.
ADAPTIVE_STORE=sqlite
ADAPTIVE_STORE_PATH=artifacts/adaptive_offers.sqlite3
# MODEL_URI=/path/to/channel_reward_model.joblib or gs://bucket/path/model.joblib
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# FEEDBACK_TOPIC=adaptive-offer-feedback
# FEEDBACK_BIGQUERY_TABLE=project.dataset.table
